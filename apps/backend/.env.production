# Production environment — set these via your deployment platform's secrets/env vars
# DO NOT commit this file; it's a template showing required vars

# Database (SQLite on persistent volume, or switch to Postgres for serverless)
DATABASE_URL="file:/data/dev.db"

# JWT
JWT_SECRET="use-a-long-random-string-from-your-secrets-manager"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV="production"

# CORS — set this to your deployed frontend URL (e.g. https://yourapp.com)
CORS_ORIGIN="https://your-frontend-url.com"

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL="warn"
